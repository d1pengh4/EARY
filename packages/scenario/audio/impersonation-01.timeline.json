[
 {
  "speaker": "other",
  "atMs": 1500,
  "durMs": 6162,
  "text": "서울중앙지검 소속 홍길동 검사입니다. 본인 명의 계좌가 범죄에 연루되어 연락드렸습니다."
 },
 {
  "speaker": "me",
  "atMs": 9500,
  "durMs": 2283,
  "text": "제 계좌가요? 무슨 일인가요?"
 },
 {
  "speaker": "other",
  "atMs": 12500,
  "durMs": 5290,
  "text": "수사 중인 사건이라 외부에 말씀하시면 안 됩니다. 지금 협조해 주셔야 합니다."
 },
 {
  "speaker": "me",
  "atMs": 19500,
  "durMs": 3072,
  "text": "잠깐만요, 제가 먼저 확인해 볼게요."
 },
 {
  "speaker": "other",
  "atMs": 23022,
  "durMs": 3876,
  "text": "오늘 안에 확인이 끝나야 합니다. 다른 곳에 전화하지 마세요."
 },
 {
  "speaker": "me",
  "atMs": 28500,
  "durMs": 2028,
  "text": "사건번호가 어떻게 되나요?"
 },
 {
  "speaker": "other",
  "atMs": 31500,
  "durMs": 5420,
  "text": "2026형제48271호입니다. 가족에게도 말씀하지 마세요."
 },
 {
  "speaker": "other",
  "atMs": 38000,
  "durMs": 4104,
  "text": "계좌가 동결되기 전에 안전계좌로 지금 바로 이체하셔야 합니다."
 },
 {
  "speaker": "me",
  "atMs": 44500,
  "durMs": 1756,
  "text": "그건 바로 못 하겠어요."
 },
 {
  "speaker": "other",
  "atMs": 47500,
  "durMs": 2784,
  "text": "문자로 가는 인증번호도 바로 불러주세요."
 },
 {
  "speaker": "other",
  "atMs": 52500,
  "durMs": 2888,
  "text": "시간이 없습니다. 지금 바로 하셔야 합니다."
 }
]